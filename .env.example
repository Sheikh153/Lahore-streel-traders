# Copy this file to .env and adjust as needed. .env is gitignored.

# Local dev: a SQLite file (relative to the project root — this is the CWD
# both `next dev`/`next start` and the `prisma` CLI run from).
# Production (Vercel): a Turso libsql:// URL — see DATABASE_AUTH_TOKEN below.
DATABASE_URL="file:./prisma/dev.db"

# Only needed when DATABASE_URL is a remote libsql:// (Turso) URL — leave
# unset for the local "file:" URL above.
# DATABASE_AUTH_TOKEN=""

# Only needed to test file uploads locally against the real Vercel Blob
# store (get this from the Vercel dashboard once the Blob store exists) —
# leave unset if you're not touching the Receipts & documents upload feature.
# BLOB_READ_WRITE_TOKEN=""

# Used to sign session cookies. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="replace-this-with-a-random-32-byte-base64-string"

# Used only by `npm run db:seed` to create the first login.
SEED_ADMIN_EMAIL="admin@scrapbusiness.local"
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_PASSWORD="ChangeMe123!"
